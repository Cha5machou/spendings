# Copy to deploy/gcp.env and fill in. That file is git-ignored.
PROJECT_ID=your-gcp-project-id
REGION=europe-west9                 # Paris. europe-west1 (Belgium) also works.
SERVICE=spendings

# Who may sign in. Each user only ever sees their own data.
# Invite-only: list the Google accounts (comma separated); everyone else gets a 403.
ALLOWED_EMAILS=you@example.com
# Or open to anyone with a verified Google account (leave ALLOWED_EMAILS empty): OPEN_SIGNUP=true
OPEN_SIGNUP=false
# Account that inherits the data you already have (migrated from the local SQLite file).
LEGACY_DATA_OWNER=you@example.com

# From Firebase console > Project settings > Your apps > Web app (these are public identifiers).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
