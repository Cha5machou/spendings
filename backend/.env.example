# Copy to .env and fill in
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Only for a cloud deployment (see docs/DEPLOY_GCP.md); leave unset locally ---
# AUTH_ENABLED=true
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# ALLOWED_EMAILS=you@example.com   # invite-only; or OPEN_SIGNUP=true for any verified Google account
# LEGACY_DATA_OWNER=you@example.com   # inherits the data created before accounts existed
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/spendings
# STORAGE_BACKEND=gcs
# GCS_BUCKET=
